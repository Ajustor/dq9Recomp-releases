<script lang="ts">
  import { effect } from '@ajustor/speedster'
  import Fenetre from './components/Fenetre.spd'
  import {
    API_DERNIERE,
    AVANCEMENT,
    MOT,
    PAGE_DES_VERSIONS,
    PAQUETS,
    date,
    detecterSysteme,
    lienDirect,
    part,
    pourcent,
    taille,
    tousLesElements,
  } from './donnees.ts'
  import type { Element, Etat, Systeme } from './donnees.ts'

  interface Version {
    nom: string
    publiee: string
    tailles: Record<string, number>
  }

  // Au rendu du build, rien de tout cela n'est connu : la page part avec les liens
  // « dernière version », qui marchent sans JavaScript. Le navigateur complète.
  let systeme: Systeme | null = null
  let version: Version | null = null

  effect(() => {
    if (typeof window === 'undefined') return
    systeme = detecterSysteme(navigator.userAgent)

    const controleur = new AbortController()
    void fetch(API_DERNIERE, { signal: controleur.signal, headers: { accept: 'application/vnd.github+json' } })
      .then((reponse) => (reponse.ok ? reponse.json() : null))
      .then((donnees: { tag_name: string; published_at: string; assets: { name: string; size: number }[] } | null) => {
        if (donnees === null) return
        const tailles: Record<string, number> = {}
        for (const fichier of donnees.assets) tailles[fichier.name] = fichier.size
        version = { nom: donnees.tag_name.replace(/^v/, ''), publiee: donnees.published_at, tailles }
      })
      // Hors ligne, ou limite de l'API atteinte : les liens directs suffisent.
      .catch(() => {})
    return () => controleur.abort()
  })

  // Chaque valeur lit `systeme` elle-même : une dérivée calculée d'une autre
  // dérivée n'est pas suivie par le compilateur (0.0.9), elle resterait figée.
  const paquetDe = (cible: Systeme | null) => PAQUETS.find((paquet) => paquet.systeme === cible)
  const lienPrincipal = paquetDe(systeme) === undefined ? '#telecharger' : lienDirect(paquetDe(systeme)?.fichier ?? '')
  const libellePrincipal = paquetDe(systeme) === undefined ? 'Télécharger' : `Télécharger pour ${paquetDe(systeme)?.nom ?? ''}`
  const nomVersion = version?.nom ?? ''
  const dateVersion = version === null ? '' : date(version?.publiee ?? '')
  const tailleDe = (fichier: string): string => {
    const octets = version?.tailles[fichier]
    return octets === undefined ? '' : ` · ${taille(octets)}`
  }

  // Le décompte du lanceur : fait 1, partiel ½, v2 hors compte.
  const GLOBAL = part(tousLesElements())
  const compter = (elements: readonly Element[], etat: Etat) => elements.filter((element) => element.state === etat).length
  const comptes = (elements: readonly Element[]) => elements.filter((element) => element.state !== 'later').length
  const largeur = (elements: readonly Element[], etat: Etat) =>
    comptes(elements) === 0 ? '0%' : `${(compter(elements, etat) / comptes(elements)) * 100}%`
</script>

<div class="ciel" aria-hidden="true"></div>

<header class="barre">
  <a class="marque" href="#accueil">DQ9<span>Recomp</span></a>
  <nav aria-label="Sections">
    <ul class="menu">
      <li><a class="choix" href="#telecharger">Télécharger</a></li>
      <li><a class="choix" href="#installer">Installer</a></li>
      <li><a class="choix" href="#avancement">Avancement</a></li>
      <li><a class="choix" href="#questions">Questions</a></li>
    </ul>
  </nav>
</header>

<main id="accueil">
  <section class="heros" aria-labelledby="titre">
    <div class="heros-texte">
      <p class="surtitre">Portage natif · Windows · Linux · Android</p>
      <h1 id="titre">DQ9<span>Recomp</span></h1>
      <p class="accroche">
        <em>Dragon Quest IX : Les Sentinelles du Firmament</em>, réécrit en Rust pour tourner
        nativement sur PC et sur téléphone. Grand écran, manette, clavier ou tactile — et vos
        journaux qui vous suivent.
      </p>

      <div class="actions">
        <a class="bouton-or" href={lienPrincipal}>{libellePrincipal}</a>
        <a class="bouton" href={PAGE_DES_VERSIONS}>Toutes les versions</a>
      </div>

      <p class="version">
        {#if nomVersion !== ''}
          Version <strong>{nomVersion}</strong> · publiée le {dateVersion}
        {:else}
          Dernière version publiée sur GitHub
        {/if}
      </p>
    </div>

    <div class="heros-dialogue">
      <Fenetre>
        <p class="dialogue">
          <span class="ligne l1">Bienvenue, Sentinelle&nbsp;!</span>
          <span class="ligne l2">Ce portage ne contient aucune donnée du jeu.</span>
          <span class="ligne l3">Apportez la ROM de votre cartouche&nbsp;: le lanceur s’occupe du reste.</span>
          <span class="suite" aria-hidden="true">▼</span>
        </p>
      </Fenetre>
    </div>
  </section>

  <section id="telecharger" class="section" aria-labelledby="titre-telecharger">
    <h2 id="titre-telecharger">Télécharger</h2>
    <Fenetre titre="Quel système ?">
      <ul class="paquets">
        {#each PAQUETS as paquet (paquet.systeme)}
          <li>
            <a class="choix paquet" class:recommande={paquet.systeme === systeme} href={lienDirect(paquet.fichier)}>
              <span class="paquet-nom">
                {paquet.nom}
                {#if paquet.systeme === systeme}<span class="badge">Votre système</span>{/if}
              </span>
              <span class="paquet-detail">{paquet.detail}</span>
              <span class="paquet-fichier">
                {paquet.fichier}{tailleDe(paquet.fichier)}
              </span>
            </a>
          </li>
        {/each}
      </ul>
    </Fenetre>
    <p class="note">
      Aucune donnée du jeu n’est incluse : chaque paquet ne contient que le moteur et son lanceur.
      Les versions précédentes et leurs notes sont sur <a href={PAGE_DES_VERSIONS}>GitHub</a>.
    </p>
  </section>

  <section id="installer" class="section" aria-labelledby="titre-installer">
    <h2 id="titre-installer">Installer</h2>
    <ol class="etapes">
      <li>
        <Fenetre titre="1 · Télécharger">
          <p>Prenez le paquet de votre système ci-dessus. Sur PC, décompressez-le où vous voulez&nbsp;: tout reste dans ce dossier.</p>
        </Fenetre>
      </li>
      <li>
        <Fenetre titre="2 · Importer la ROM">
          <p>Lancez <code>dq9-runtime</code> (ou l’application DQ9Recomp) et choisissez la ROM européenne, copiée depuis votre propre cartouche.</p>
          <dl class="rom">
            <dt>Version</dt><dd>Europe (En, Fr, De, Es, It)</dd>
            <dt>Code</dt><dd><code class="or">YDQP</code></dd>
            <dt>Fichier</dt><dd>.nds, environ 256&nbsp;Mio</dd>
          </dl>
        </Fenetre>
      </li>
      <li>
        <Fenetre titre="3 · Jouer">
          <p>Graphismes, textes, musiques et cinématiques sont extraits une fois pour toutes sur votre appareil. Ensuite, c’est l’écran titre.</p>
        </Fenetre>
      </li>
    </ol>

    <div class="encarts">
      <Fenetre titre="Android">
        <p>
          L’APK ne vient pas du Play Store&nbsp;: autorisez votre navigateur à installer des
          applications, puis ouvrez le fichier téléchargé. Play Protect peut demander une
          confirmation&nbsp;: l’APK est signé, toujours de la même clé.
        </p>
      </Fenetre>
      <Fenetre titre="Mises à jour">
        <p>
          Le lanceur cherche les nouvelles versions au démarrage et les installe pour vous
          (<em>Réglages → Rechercher une mise à jour</em>). Vos journaux sont conservés.
        </p>
      </Fenetre>
    </div>
  </section>

  <section id="avancement" class="section" aria-labelledby="titre-avancement">
    <h2 id="titre-avancement">Avancement</h2>
    <Fenetre titre="Statut">
      <div class="statut-total">
        <span class="pourcent">{pourcent(GLOBAL)}<small>%</small></span>
        <div class="statut-texte">
          <p>Avancement global du portage&nbsp;: ce qui est réellement en place dans le moteur.</p>
          <p class="statut-legende">
            Un élément fait compte pour 1, partiel pour ½&nbsp;; ceux prévus pour la v2 (multijoueur)
            ne comptent pas. Mis à jour le {date(AVANCEMENT.updated)}.
          </p>
        </div>
      </div>
      <span class="jauge jauge-globale" role="img" aria-label="{pourcent(GLOBAL)} % du portage en place">
        <span class="jauge-fait" style:width={`${GLOBAL * 100}%`}></span>
      </span>

      <ul class="domaines">
        {#each AVANCEMENT.domains as domaine (domaine.name)}
          <li>
            <details class="domaine">
              <summary class="choix">
                <span class="domaine-tete">
                  <span class="domaine-pourcent">{pourcent(part(domaine.items))}&nbsp;%</span>
                  <span class="domaine-nom">{domaine.name}</span>
                  <span class="domaine-compte">{compter(domaine.items, 'done')} faits sur {comptes(domaine.items)}</span>
                </span>
                <span class="jauge" aria-hidden="true">
                  <span class="jauge-fait" style:width={largeur(domaine.items, 'done')}></span>
                  <span class="jauge-partiel" style:width={largeur(domaine.items, 'partial')}></span>
                </span>
              </summary>
              <ul class="elements">
                {#each domaine.items as element (element.name)}
                  <li class="element">
                    <span class="etat etat-{element.state}">{MOT[element.state]}</span>
                    <span class="element-texte">
                      <span class="element-nom">{element.name}</span>
                      {#if element.note !== undefined}<span class="element-note">{element.note}</span>{/if}
                    </span>
                  </li>
                {/each}
              </ul>
            </details>
          </li>
        {/each}
      </ul>
    </Fenetre>
    <p class="note">
      Choisissez un domaine pour voir le détail, comme dans l’onglet Avancement du lanceur.
    </p>
  </section>

  <section id="questions" class="section" aria-labelledby="titre-questions">
    <h2 id="titre-questions">Questions</h2>
    <div class="faq">
      <details>
        <summary class="choix">Est-ce un émulateur&nbsp;?</summary>
        <p>Non. C’est un moteur natif, écrit en Rust d’après la lecture du code ARM du jeu&nbsp;: ni émulation, ni recompilation statique. D’où la haute résolution et la fluidité.</p>
      </details>
      <details>
        <summary class="choix">Pourquoi faut-il ma propre ROM&nbsp;?</summary>
        <p>Le projet ne distribue aucune donnée du jeu. Le lanceur vérifie la ROM (code YDQP), puis en extrait les ressources localement. Une autre version est refusée avec une explication.</p>
      </details>
      <details>
        <summary class="choix">Puis-je reprendre ma sauvegarde DS&nbsp;?</summary>
        <p>Oui&nbsp;: dans la page Journaux du lanceur, «&nbsp;Importer une sauvegarde DS&nbsp;» accepte les fichiers <code>.sav</code> et <code>.dsv</code>.</p>
      </details>
      <details>
        <summary class="choix">Avec quoi joue-t-on&nbsp;?</summary>
        <p>Clavier, manette, souris ou doigt. Les touches se reconfigurent dans le lanceur&nbsp;; sur Android, une manette tactile s’affiche en jeu.</p>
      </details>
    </div>
  </section>
</main>

<footer class="pied">
  <p>
    Projet de fans non officiel, sans lien avec Square Enix, Level-5 ou Nintendo.
    <em>Dragon Quest</em> est une marque de Square Enix. Aucune donnée du jeu n’est distribuée.
  </p>
  <p><a href="https://github.com/Ajustor/dq9Recomp-releases">Ajustor/dq9Recomp-releases</a></p>
</footer>

<style>
  .ciel {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(1.5px 1.5px at 20% 30%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 15%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 85% 60%, var(--or-clair) 50%, transparent 51%),
      radial-gradient(1px 1px at 40% 80%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 55% 45%, #cfe0ff 50%, transparent 51%),
      radial-gradient(2px 2px at 10% 70%, #fff 50%, transparent 51%);
    background-size: 340px 340px, 260px 260px, 420px 420px, 300px 300px, 220px 220px, 520px 520px;
    opacity: 0.75;
    animation: scintille 6s ease-in-out infinite alternate;
  }

  @keyframes scintille {
    from { opacity: 0.45 }
    to { opacity: 0.85 }
  }

  /* --- La barre du haut ------------------------------------------------- */

  .barre {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.7rem clamp(1rem, 4vw, 3rem);
    background: rgba(8, 11, 22, 0.82);
    border-bottom: 1px solid var(--bord);
    backdrop-filter: blur(8px);
  }

  .marque {
    font-family: var(--police-titre);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--texte);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .marque span, h1 span { color: var(--or) }

  .menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Le curseur des menus : une flèche dorée qui clignote ------------- */

  .choix {
    position: relative;
    display: inline-block;
    padding: 0.45rem 0.7rem 0.45rem 1.55rem;
    font-family: var(--police-menu);
    color: var(--texte);
    text-decoration: none;
    border-radius: 8px;
    cursor: pointer;
  }

  .choix::before {
    content: '▶';
    position: absolute;
    left: 0.35rem;
    top: 0.45rem;
    font-size: 0.8em;
    line-height: 1.6;
    color: var(--or);
    opacity: 0;
  }

  .choix:hover::before,
  .choix:focus-visible::before {
    opacity: 1;
    animation: curseur 0.8s steps(2, jump-none) infinite;
  }

  .choix:hover, .choix:focus-visible { color: #fff }
  .choix:focus-visible { outline: 2px solid var(--or-clair); outline-offset: 2px }

  @keyframes curseur {
    from { opacity: 1 }
    to { opacity: 0.15 }
  }

  /* --- L'accueil --------------------------------------------------------- */

  main { padding: 0 clamp(1rem, 4vw, 3rem) }

  .heros {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 72rem;
    min-height: min(78vh, 46rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 8vh, 5rem) 0;
  }

  .surtitre {
    margin: 0 0 0.75rem;
    font-family: var(--police-menu);
    color: var(--ciel-clair);
    letter-spacing: 0.08em;
    animation: monte 0.7s ease-out both;
  }

  h1 {
    margin: 0;
    font-family: var(--police-titre);
    font-weight: 700;
    font-size: clamp(3rem, 7.4vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 0 0 40px rgba(232, 182, 76, 0.35), 0 4px 0 #0a0f1f;
    animation: monte 0.7s 0.1s ease-out both;
  }

  .accroche {
    max-width: 36rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--texte-doux);
    animation: monte 0.7s 0.2s ease-out both;
  }

  .accroche em { color: var(--texte); font-style: normal }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    animation: monte 0.7s 0.3s ease-out both;
  }

  /* Le bouton principal du lanceur : doré, texte brun sombre. */
  .bouton-or, .bouton {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    font-family: var(--police-menu);
    font-size: 1.1rem;
    text-decoration: none;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .bouton-or {
    color: #1e1606;
    background: linear-gradient(180deg, var(--or-clair), var(--or));
    border: 1px solid var(--or-clair);
    box-shadow: 0 0 0 3px rgba(232, 182, 76, 0.18), 0 10px 30px -10px rgba(232, 182, 76, 0.7);
  }

  .bouton {
    color: var(--texte);
    background: var(--releve);
    border: 1px solid var(--bord);
  }

  .bouton-or:hover, .bouton-or:focus-visible { transform: translateY(-2px); box-shadow: 0 0 0 4px rgba(248, 208, 120, 0.3), 0 14px 34px -10px rgba(232, 182, 76, 0.85) }
  .bouton:hover, .bouton:focus-visible { background: var(--survol); border-color: var(--or) }
  .bouton-or:focus-visible, .bouton:focus-visible { outline: 2px solid #fff; outline-offset: 3px }

  .version {
    margin: 1.1rem 0 0;
    font-size: 0.92rem;
    color: var(--faible);
    animation: monte 0.7s 0.4s ease-out both;
  }

  .version strong { color: var(--or-clair); font-weight: 400; font-family: var(--police-menu) }

  .heros-dialogue { animation: monte 0.8s 0.5s ease-out both }

  .dialogue {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--police-menu);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .ligne { animation: apparait 0.5s ease-out both }
  .l1 { animation-delay: 0.9s }
  .l2 { animation-delay: 1.5s }
  .l3 { animation-delay: 2.1s }

  .suite {
    justify-self: center;
    color: var(--or);
    font-size: 0.9rem;
    animation: apparait 0.3s 2.6s both, rebond 0.9s 2.9s ease-in-out infinite;
  }

  @keyframes monte {
    from { opacity: 0; transform: translateY(14px) }
    to { opacity: 1; transform: none }
  }

  @keyframes apparait {
    from { opacity: 0 }
    to { opacity: 1 }
  }

  @keyframes rebond {
    0%, 100% { transform: translateY(0) }
    50% { transform: translateY(4px) }
  }

  /* --- Les sections ------------------------------------------------------ */

  .section {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 0;
    scroll-margin-top: 4.5rem;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.75rem;
    font-family: var(--police-titre);
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: #fff;
  }

  /* Un filet doré qui file vers la droite, terminé par une étoile. */
  h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--or), transparent);
    opacity: 0.6;
  }

  .note {
    max-width: 48rem;
    margin: 1.25rem 0 0;
    color: var(--faible);
    line-height: 1.65;
  }

  a { color: var(--ciel-clair) }
  code { font-family: var(--police-menu); color: var(--or-clair) }

  /* --- Télécharger ------------------------------------------------------- */

  .paquets {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paquet {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    width: 100%;
    box-sizing: border-box;
    padding: 0.9rem 1rem 0.9rem 2rem;
  }

  .paquet::before { top: 0.95rem; left: 0.6rem }

  .paquet:hover, .paquet:focus-visible { background: rgba(255, 255, 255, 0.06) }

  .recommande { background: rgba(232, 182, 76, 0.1) }
  .recommande::before { opacity: 1; animation: curseur 0.8s steps(2, jump-none) infinite }

  .paquet-nom { font-size: 1.3rem; color: #fff }
  .paquet-detail { font-family: var(--police-texte); color: var(--texte-doux) }
  .paquet-fichier { font-size: 0.85rem; color: var(--faible); white-space: nowrap }

  .badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.5rem;
    font-size: 0.75rem;
    vertical-align: middle;
    color: #1e1606;
    background: var(--or);
    border-radius: 999px;
  }

  /* --- Installer --------------------------------------------------------- */

  .etapes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etapes p, .encarts p { margin: 0; line-height: 1.65; color: var(--texte-doux) }

  .rom {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 1rem;
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }

  .rom dt { color: var(--faible) }
  .rom dd { margin: 0 }

  .encarts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  /* --- Avancement : la page du lanceur, en fenêtre du jeu --------------- */

  .statut-total {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .statut-texte p { margin: 0 0 0.3rem; line-height: 1.55 }

  .pourcent {
    font-family: var(--police-titre);
    font-weight: 700;
    font-size: 4.2rem;
    line-height: 1;
    color: var(--or-clair);
    text-shadow: 0 0 30px rgba(232, 182, 76, 0.35);
  }

  .pourcent small { font-size: 0.45em; margin-left: 0.15rem }
  .statut-legende { font-size: 0.88rem; color: var(--faible) }

  /* Une jauge de PV : un rail sombre bordé, rempli. */
  .jauge {
    display: flex;
    height: 0.6rem;
    overflow: hidden;
    background: #070b18;
    border: 1px solid var(--bord);
    border-radius: 999px;
  }

  .jauge-globale { height: 0.75rem; margin: 1rem 0 1.25rem }
  .jauge-globale .jauge-fait { background: linear-gradient(90deg, var(--or), var(--or-clair)) }
  .jauge-fait { background: linear-gradient(90deg, #4fae70, var(--ok)) }
  .jauge-partiel { background: repeating-linear-gradient(135deg, var(--avert) 0 4px, #a8721f 4px 8px) }

  .domaines {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .domaine summary {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    padding: 0.6rem 0.8rem 0.6rem 1.9rem;
    list-style: none;
  }

  .domaine summary::-webkit-details-marker { display: none }
  .domaine summary::before { top: 0.6rem; left: 0.55rem }
  .domaine summary:hover, .domaine summary:focus-visible { background: rgba(255, 255, 255, 0.05) }
  .domaines > li + li { border-top: 1px solid rgba(48, 62, 100, 0.6) }
  .domaine[open] summary::before { content: '▼'; opacity: 1; animation: none }

  .domaine-tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .domaine-pourcent { min-width: 3.2rem; color: var(--or-clair) }
  .domaine-nom { flex: 1; color: #fff }
  .domaine-compte { font-size: 0.85rem; color: var(--faible) }

  .elements {
    display: grid;
    gap: 0.45rem;
    margin: 0.3rem 0 0.9rem;
    padding: 0.8rem 1rem 0.8rem 1.9rem;
    list-style: none;
    background: rgba(5, 8, 20, 0.45);
    border-radius: 8px;
  }

  .element {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    line-height: 1.5;
  }

  .etat { font-family: var(--police-menu); font-size: 0.92rem }
  .etat-done { color: var(--ok) }
  .etat-partial { color: var(--avert) }
  .etat-missing { color: var(--erreur) }
  .etat-later { color: var(--ciel) }

  .element-texte { display: flex; flex-wrap: wrap; gap: 0.1rem 0.6rem }
  .element-nom { color: var(--texte) }
  .element-note { color: var(--faible); font-size: 0.92rem }

  /* --- Questions --------------------------------------------------------- */

  .faq { display: grid; gap: 0.6rem; max-width: 52rem }

  .faq details {
    background: linear-gradient(180deg, var(--fenetre-haut), var(--fenetre-bas));
    border: 2px solid var(--cadre);
    border-radius: 12px;
    box-shadow: 0 0 0 2px var(--cadre-ombre);
  }

  .faq summary {
    display: block;
    padding: 0.85rem 1rem 0.85rem 2rem;
    font-size: 1.05rem;
    list-style: none;
  }

  .faq summary::-webkit-details-marker { display: none }
  .faq summary::before { top: 0.9rem; left: 0.7rem }
  .faq details[open] summary::before { opacity: 1 }

  .faq details p {
    margin: 0;
    padding: 0 1.25rem 1.1rem 2rem;
    line-height: 1.7;
    color: var(--texte-doux);
  }

  /* --- Pied -------------------------------------------------------------- */

  .pied {
    margin-top: 3rem;
    padding: 2rem clamp(1rem, 4vw, 3rem) 3rem;
    font-size: 0.88rem;
    color: var(--faible);
    text-align: center;
    border-top: 1px solid var(--bord);
  }

  .pied p { margin: 0.35rem auto; max-width: 46rem; line-height: 1.6 }

  /* --- Petits écrans ----------------------------------------------------- */

  @media (max-width: 60rem) {
    .heros { grid-template-columns: 1fr; min-height: 0 }
    .etapes, .encarts { grid-template-columns: 1fr }
  }

  @media (max-width: 40rem) {
    .paquet { grid-template-columns: 1fr }
    .paquet-fichier { white-space: normal }
    .statut-total { flex-direction: column; align-items: flex-start; gap: 0.75rem }
    .element { grid-template-columns: 1fr; gap: 0 }
    .menu .choix { padding-right: 0.4rem; font-size: 0.92rem }
  }

  @media (prefers-reduced-motion: reduce) {
    .ciel, .choix:hover::before, .choix:focus-visible::before, .recommande::before, .suite { animation: none }
    .surtitre, h1, .accroche, .actions, .version, .heros-dialogue, .ligne { animation: none }
  }
</style>
