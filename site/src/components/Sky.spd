<!-- Le ciel étoilé derrière toute la page : décoratif, fixe, sans interaction. -->
<div class="sky" aria-hidden="true"></div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(1.5px 1.5px at 20% 30%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 15%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 85% 60%, var(--gold-light) 50%, transparent 51%),
      radial-gradient(1px 1px at 40% 80%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 55% 45%, #cfe0ff 50%, transparent 51%),
      radial-gradient(2px 2px at 10% 70%, #fff 50%, transparent 51%);
    background-size: 340px 340px, 260px 260px, 420px 420px, 300px 300px, 220px 220px, 520px 520px;
    opacity: 0.75;
    animation: twinkle 6s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    from { opacity: 0.45 }
    to { opacity: 0.85 }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky { animation: none }
  }
</style>
