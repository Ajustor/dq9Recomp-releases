    animation: rise 0.7s 0.4s ease-out both;
  }

  .release strong { color: var(--gold-light); font-weight: 400; font-family: var(--font-menu) }

  /* --- La fenêtre de dialogue : les lignes arrivent une à une ------------ */

  .hero-dialogue { animation: rise 0.8s 0.5s ease-out both }

