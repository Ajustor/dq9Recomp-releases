<script lang="ts">
  import Window from '../../components/Window.spd'
  import { PACKAGES, RELEASES_PAGE, directLink } from '../../data.ts'
  import type { Platform, Release } from '../../data.ts'

  /** Le système du visiteur ; `null` au rendu du build, ou s'il n'est pas reconnu. */
  export let platform: Platform | null
  /** La dernière version publiée ; `null` tant que l'API n'a pas répondu. */
  export let release: Release | null

  const recommended = PACKAGES.find((entry) => entry.platform === platform)
  const mainLink = recommended === undefined ? '#download' : directLink(recommended.file)
  const mainLabel =
    recommended === undefined ? t.home.download : t.home.downloadFor({ platform: recommended.name })
</script>

<section class="hero" aria-labelledby="title">
  <div class="hero-text">
    <p class="kicker">{t.home.kicker}</p>
    <h1 id="title">DQ9<span>Recomp</span></h1>
    <p class="tagline">
      <em>{t.home.game}</em>{t.home.tagline}
    </p>

    <div class="actions">
      <a class="button-gold" href={mainLink}>{mainLabel}</a>
      <a class="button" href={RELEASES_PAGE}>{t.home.allReleases}</a>
    </div>

    <p class="release">
      {#if release !== null}
        {t.home.version} <strong>{release.name}</strong> {t.home.released({ date: new Date(release.publishedAt) })}
      {:else}
        {t.home.latest}
      {/if}
    </p>
  </div>

  <div class="hero-dialogue">
    <Window>
      <p class="dialogue">
        <span class="line line1">{t.dialogue.line1}</span>
        <span class="line line2">{t.dialogue.line2}</span>
        <span class="line line3">{t.dialogue.line3}</span>
        <span class="next" aria-hidden="true">▼</span>
      </p>
    </Window>
  </div>
</section>

