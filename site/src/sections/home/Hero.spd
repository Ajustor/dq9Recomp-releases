    box-shadow: 0 0 0 3px rgba(232, 182, 76, 0.18), 0 10px 30px -10px rgba(232, 182, 76, 0.7);
  }

  .button {
    color: var(--text);
    background: var(--raised);
    border: 1px solid var(--border);
  }

  .button-gold:hover, .button-gold:focus-visible { transform: translateY(-2px); box-shadow: 0 0 0 4px rgba(248, 208, 120, 0.3), 0 14px 34px -10px rgba(232, 182, 76, 0.85) }
  .button:hover, .button:focus-visible { background: var(--hover); border-color: var(--gold) }
  .button-gold:focus-visible, .button:focus-visible { outline: 2px solid #fff; outline-offset: 3px }

  .release {
    margin: 1.1rem 0 0;
