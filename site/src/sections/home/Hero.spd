  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    animation: rise 0.7s 0.3s ease-out both;
  }

  /* Le bouton principal du lanceur : doré, texte brun sombre. */
  .button-gold, .button {
