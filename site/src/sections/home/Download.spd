<script lang="ts">
  import Section from '../../components/Section.spd'
  import Window from '../../components/Window.spd'
  import { PACKAGES, RELEASES_PAGE, directLink, mebibytes } from '../../data.ts'
  import type { Platform, Release } from '../../data.ts'

  export let platform: Platform | null
  export let release: Release | null

  const sizeOf = (file: string): string => {
    const bytes = release?.sizes[file]
    return bytes === undefined ? '' : ` · ${t.download.size({ n: mebibytes(bytes) })}`
  }
</script>

<Section id="download" title={t.download.title}>
  <Window title={t.download.which}>
    <ul class="packages">
      {#each PACKAGES as entry (entry.platform)}
        <li>
          <a
            class="menu-item package"
            class:recommended={entry.platform === platform}
            class:menu-item-active={entry.platform === platform}
            href={directLink(entry.file)}
          >
            <span class="package-name">
              {entry.name}
              {#if entry.platform === platform}<span class="badge">{t.download.yours}</span>{/if}
            </span>
            <span class="package-detail">{t.download[entry.platform]}</span>
            <span class="package-file">{entry.file}{sizeOf(entry.file)}</span>
          </a>
        </li>
      {/each}
    </ul>
  </Window>
  <p class="note">
    {t.download.note} <a href={RELEASES_PAGE}>{t.download.noteLink}</a>.
  </p>
</Section>

<style>
  .packages {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .package {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2rem;
  }

  .package::before { top: 0.95rem; left: 0.6rem }
  .package:hover, .package:focus-visible { background: rgba(255, 255, 255, 0.06) }

  /* Le paquet du visiteur : surligné, et le curseur s'y pose d'office. */
  .recommended { background: rgba(232, 182, 76, 0.1) }

  .package-name { font-size: 1.3rem; color: #fff }
  .package-detail { font-family: var(--font-body); color: var(--text-soft) }
  .package-file { font-size: 0.85rem; color: var(--weak); white-space: nowrap }

  .badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.5rem;
    font-size: 0.75rem;
    vertical-align: middle;
    color: #1e1606;
    background: var(--gold);
    border-radius: 999px;
  }

  @media (max-width: 40rem) {
    .package { grid-template-columns: 1fr }
    .package-file { white-space: normal }
  }
</style>
